{
  "manifest_version": 3,
  "name": "Quizzer",
  "version": "0.1.0",
  "description": "Turn any page or highlighted passage into an endless, adaptive quiz, with AI explanations for every answer.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/chip.js"],
      "css": ["content/page.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Quizzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
